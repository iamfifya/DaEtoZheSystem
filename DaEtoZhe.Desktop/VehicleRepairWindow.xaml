<Window x:Class="DaEtoZhe.Desktop.VehicleRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
        Title="Ремонт автомобиля"
        WindowStartupLocation="CenterScreen"
        Width="1250" Height="820"
        Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: Заголовок и инфо об авто ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Text="🔧 Ремонт" Style="{StaticResource HeadingMediumStyle}"/>
            <TextBlock x:Name="VehicleInfoText" Style="{StaticResource TextSecondaryStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ═══ ROW 1: Финансовый пульс ремонта ═══ -->
        <Border Grid.Row="1" Margin="0,0,0,16" Style="{StaticResource CardFlatStyle}" Padding="16">
            <UniformGrid Columns="5">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Запчасти" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PartsCostText" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentOrange}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Работы" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LaborCostText" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ИТОГО факт" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalCostText" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Смета приёмки" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EstimateText" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Превышение сметы" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OverrunText" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ═══ ROW 2: Запчасти (слева) + Работы (справа) ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВО: запчасти -->
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📦 Запчасти со склада" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,8"/>

                <Border Grid.Row="1" Style="{StaticResource CardFlatStyle}" Padding="12" Margin="{StaticResource ControlPaddingLG}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource ControlPaddingLG}">
                            <TextBlock x:Name="StockHintText" Style="{StaticResource FormLabelStyle}" Margin="{StaticResource FormLabelMargin}"/>
                            <controls:CustomComboBox x:Name="ItemCombo" Header="Позиция номенклатуры"
                                DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="{StaticResource ControlPaddingLG}">
                            <TextBlock Text="Кол-во" Style="{StaticResource FilterLabelStyle}" Margin="{StaticResource FormLabelMargin}"/>
                            <TextBox x:Name="PartQtyTextBox"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="➕ Списать" Style="{StaticResource PrimaryBtn}"
                                VerticalAlignment="Bottom" Click="AddPart_Click" Margin="{StaticResource ControlPaddingLG}"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="PartsGrid" Grid.Row="2" Style="{StaticResource AuditDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Позиция" Binding="{Binding StockItem.Name}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="75"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding CostPrice, StringFormat=N2}" Width="85"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalCost, StringFormat=N0}" Width="95"/>
                        <DataGridTemplateColumn Header="" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="↩" Click="ReturnPart_Click" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource AccentRed}" ToolTip="Вернуть на склад (сторно)"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ПРАВО: работы -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="👨‍🔧 Работы механиков" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,8"/>

                <Border Grid.Row="1" Style="{StaticResource CardFlatStyle}" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,8">
                            <controls:CustomComboBox x:Name="MechanicCombo" Header="Механик" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,8">
                            <controls:CustomComboBox x:Name="DefectCombo" Header="Дефект (опц.)" DisplayMemberPath="Description" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,8">
                            <TextBlock Text="План, ч" Style="{StaticResource FilterLabelStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PlannedHoursTextBox"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,8,8">
                            <TextBlock Text="Факт, ч" Style="{StaticResource FilterLabelStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ActualHoursTextBox"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,8,8">
                            <TextBlock Text="Ставка ₽/ч" Style="{StaticResource FilterLabelStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="RateTextBox"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5" Margin="0,0,0,8">
                            <controls:CustomComboBox x:Name="WorkStatusCombo" Header="Статус" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,8,0">
                            <TextBlock Text="Описание работы" Style="{StaticResource FilterLabelStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="WorkDescTextBox"/>
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="5" x:Name="SaveWorkButton" Content="➕ Добавить"
                                Style="{StaticResource SuccessBtn}" VerticalAlignment="Bottom" Click="SaveWork_Click" Margin="{StaticResource ControlPaddingLG}"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="WorksGrid" Grid.Row="2" Style="{StaticResource AuditDataGridStyle}"
                          SelectionChanged="WorksGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Механик" Binding="{Binding Mechanic.FullName}" Width="115"/>
                        <DataGridTextColumn Header="Работа" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Часы" Binding="{Binding ActualHours, StringFormat={}{0:0.#}}" Width="60"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalCost, StringFormat=N0}" Width="85"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="85"/>
                        <DataGridTemplateColumn Header="" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Click="DeleteWork_Click" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource AccentRed}" ToolTip="Удалить работу"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ═══ ROW 3: Бригада и проценты ЗП ═══ -->
        <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource CardFlatStyle}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="👷 Бригада и проценты ЗП" Style="{StaticResource HeadingSmallStyle}"/>
                        <TextBlock x:Name="ShareSumText" FontSize="13" FontWeight="SemiBold"
                                   Margin="15,0,0,2" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="SharesGrid" Style="{StaticResource AuditDataGridStyle}"
                              MaxHeight="180" SelectionChanged="SharesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Механик" Binding="{Binding Mechanic.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Доля" Binding="{Binding SharePercent, StringFormat={}{0:0.##}%}" Width="75"/>
                            <DataGridTextColumn Header="К начислению" Binding="{Binding EarnedAmount, StringFormat=N0}" Width="115"/>
                            <DataGridTemplateColumn Header="" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" Click="DeleteShare_Click" Tag="{Binding}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Foreground="{DynamicResource AccentRed}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource BgMain}" CornerRadius="{DynamicResource RadiusMD}" Padding="12"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <controls:CustomComboBox x:Name="ShareMechanicCombo" Header="Механик"
                                  DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                        <TextBlock Text="Процент доли" Style="{StaticResource FilterLabelStyle}" Margin="0,10,0,4"/>
                        <TextBox x:Name="SharePercentTextBox"
                                 PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource CardPadding}">
                            <Button x:Name="AddShareButton" Content="➕ Добавить" Style="{StaticResource PrimaryBtn}"
                                    Click="AddShare_Click"/>
                            <Button x:Name="SaveShareButton" Content="💾 Сохранить" Style="{StaticResource SuccessBtn}"
                                    Click="SaveShare_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ ROW 4: Футер с кнопками ═══ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="✅ Завершить ремонт" Style="{StaticResource SuccessBtn}" Click="Finish_Click" Margin="0,0,10,0"/>
            <Button Content="🔄 Обновить" Style="{StaticResource PrimaryBtn}" Click="Refresh_Click" Margin="0,0,10,0"/>
            <Button Content="✖ Закрыть" Style="{StaticResource DangerBtn}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>