<Window x:Class="DaEtoZhe.Desktop.VehicleAcceptanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
        Title="Акт приёмки и дефектная ведомость"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="1150" MinHeight="780"
        Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="{StaticResource WindowContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <TextBlock x:Name="TitleText" Text="📋 Акт приёмки"
                   Style="{StaticResource HeadingMediumStyle}"
                   Margin="{StaticResource PageTitleMargin}"/>
        <TextBlock x:Name="VehicleInfoText" Grid.Row="1"
                   Style="{StaticResource TextSecondaryStyle}"
                   TextWrapping="Wrap"
                   Margin="{StaticResource PageSubtitleMargin}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT: АКТ ПРИЁМКИ ==================== -->
            <Border Style="{StaticResource CardFlatStyle}"
                    Margin="{StaticResource HCardGapMargin}">
                <StackPanel>
                    <TextBlock Text="📄 Акт приёмки" Style="{StaticResource CardHeaderStyle}"/>

                    <TextBlock Text="Ключей, шт" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="KeysTextBox"
                             Margin="{StaticResource FormFieldMargin}"
                             PreviewTextInput="NumericOnly_PreviewTextInput"/>

                    <CheckBox x:Name="PtsCheckBox" Content="ПТС на руках"
                              Margin="{StaticResource FormFieldMargin}"/>
                    <CheckBox x:Name="StsCheckBox" Content="СТС на руках"
                              Margin="{StaticResource FormFieldMargin}"/>

                    <TextBlock Text="Документы (примечания)" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="DocsNotesTextBox"
                             Style="{StaticResource MultilineTextBoxSmallStyle}"
                             Margin="{StaticResource FormFieldMargin}"/>

                    <TextBlock Text="Общее состояние при осмотре" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="ConditionTextBox"
                             Style="{StaticResource MultilineTextBoxStyle}"/>

                    <TextBlock x:Name="AcceptedInfoText"
                               Style="{StaticResource SuccessInfoStyle}"
                               Margin="{StaticResource FormSectionTopMargin}"/>
                </StackPanel>
            </Border>

            <!-- ==================== RIGHT: ДЕФЕКТНАЯ ВЕДОМОСТЬ ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Форма добавления дефекта -->
                <Border Style="{StaticResource CardFlatStyle}"
                        Margin="{StaticResource CardGapMargin}">
                    <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Описание дефекта -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Описание дефекта *"
                                       Style="{StaticResource FormLabelStyle}"
                                       Margin="{StaticResource FormLabelMargin}"/>
                            <TextBox x:Name="DefectDescTextBox"
                                     Height="{StaticResource ControlHeightMD}"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Зона (используем встроенный Header комбобокса без лишней StackPanel) -->
                        <controls:CustomComboBox x:Name="AreaCombo"
                                 Grid.Column="1"
                                 Header="Зона"
                                 VerticalAlignment="Top"
                                 Margin="{StaticResource ControlPaddingLG}"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Value"/>

                        <!-- Критичность -->
                        <controls:CustomComboBox x:Name="SeverityCombo"
                                 Grid.Column="2"
                                 Header="Критичность"
                                 VerticalAlignment="Top"
                                 Margin="{StaticResource ControlPaddingLG}"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Value"/>

                        <!-- Цена -->
                        <StackPanel Grid.Column="3"
                                    Margin="{StaticResource ControlPaddingLG}"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Цена, ₽"
                                       Style="{StaticResource FormLabelStyle}"
                                       Margin="{StaticResource FormLabelMargin}"/>
                            <TextBox x:Name="DefectCostTextBox"
                                     Height="{StaticResource ControlHeightMD}"
                                     VerticalContentAlignment="Center"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>

                        <!-- Нормо-часы -->
                        <StackPanel Grid.Column="4"
                                    Margin="{StaticResource ControlPaddingLG}"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Нормо-часы"
                                       Style="{StaticResource FormLabelStyle}"
                                       Margin="{StaticResource FormLabelMargin}"/>
                            <TextBox x:Name="DefectHoursTextBox"
                                     Height="{StaticResource ControlHeightMD}"
                                     VerticalContentAlignment="Center"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>

                        <!-- Действия (привязаны к нижнему краю вровень с полями) -->
                        <StackPanel Grid.Column="5"
                                    Orientation="Vertical"
                                    VerticalAlignment="Bottom"
                                    Margin="{StaticResource ControlPaddingLG}">
                            <TextBlock Text="Действия"
                                       Style="{StaticResource FormLabelStyle}"
                                       Margin="{StaticResource FormLabelMargin}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AddDefectButton" Content="➕"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="AddDefect_Click"
                                        ToolTip="Добавить дефект"/>
                                <Button x:Name="UpdateDefectButton" Content="💾"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="UpdateDefect_Click"
                                        ToolTip="Сохранить выбранный дефект"
                                        IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Таблица дефектов -->
                <DataGrid x:Name="DefectsGrid" Grid.Row="1"
                          Style="{StaticResource AuditDataGridStyle}"
                          SelectionMode="Single" SelectionChanged="DefectsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Зона" Binding="{Binding AreaName}" Width="110"/>
                        <DataGridTextColumn Header="Крит." Binding="{Binding SeverityName}" Width="90"/>
                        <DataGridTextColumn Header="Дефект" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding EstimatedCost, StringFormat=N0}" Width="90"/>
                        <DataGridTextColumn Header="Часы" Binding="{Binding EstimatedHours, StringFormat=N1}" Width="65"/>
                        <DataGridCheckBoxColumn Header="Устранён" Binding="{Binding IsFixed, Mode=OneWay}" Width="80"/>
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🔧" Style="{StaticResource GridActionButtonStyle}"
                                                Click="ToggleFixed_Click" Tag="{Binding}"
                                                ToolTip="Отметить устранённым / вернуть"/>
                                        <Button Content="🗑" Style="{StaticResource GridActionButtonStyle}"
                                                Click="DeleteDefect_Click" Tag="{Binding}"
                                                Foreground="{DynamicResource AccentRed}" ToolTip="Удалить"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ==================== FOOTER: СМЕТА И ДЕЙСТВИЯ ==================== -->
        <Border Grid.Row="3" Style="{StaticResource CardFlatStyle}"
                Margin="{StaticResource CardGapMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Смета ремонта: " Style="{StaticResource TextSecondaryStyle}"/>
                    <TextBlock x:Name="EstimateText" Style="{StaticResource StatValueStyle}"
                               Margin="{StaticResource StatGapMargin}"/>
                    <TextBlock x:Name="DefectsCountText" Style="{StaticResource TextSecondaryStyle}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource StatGapMargin}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="💾 Сохранить акт и оценить" Style="{StaticResource SuccessBtn}"
                            Click="Accept_Click" Margin="{StaticResource ButtonGapMargin}"/>
                    <Button Content="✖ Закрыть" Style="{StaticResource DangerBtn}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>