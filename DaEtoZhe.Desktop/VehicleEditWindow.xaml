<Window x:Class="DaEtoZhe.Desktop.VehicleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
        Title="Карточка автомобиля"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="820" Height="780"
        Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="➕ Новый автомобиль" Style="{StaticResource HeadingMediumStyle}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ СЕКЦИЯ 1: ИДЕНТИФИКАЦИЯ ═══ -->
                <Border Style="{StaticResource CardFlatStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🚗 Идентификация" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="VIN" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="VinTextBox" MaxLength="17"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="Гос. номер *" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PlateTextBox" MaxLength="15"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="Марка *" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MakeTextBox" MaxLength="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="Модель *" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ModelTextBox" MaxLength="50"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="Год выпуска" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="YearTextBox"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="Пробег, км" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MileageTextBox"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="Цвет" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ColorTextBox" MaxLength="30"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,12">
                                <controls:CustomComboBox x:Name="EngineTypeCombo" Header="Двигатель">
                                    <ComboBoxItem Content="Бензин"/>
                                    <ComboBoxItem Content="Дизель"/>
                                    <ComboBoxItem Content="Гибрид"/>
                                    <ComboBoxItem Content="Электро"/>
                                    <ComboBoxItem Content="Газ"/>
                                </controls:CustomComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="Объём двигателя, л" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="EngineVolumeTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,12">
                                <controls:CustomComboBox x:Name="TransmissionCombo" Header="КПП">
                                    <ComboBoxItem Content="АКПП"/>
                                    <ComboBoxItem Content="МКПП"/>
                                    <ComboBoxItem Content="Робот"/>
                                    <ComboBoxItem Content="Вариатор"/>
                                </controls:CustomComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,10,0">
                                <controls:CustomComboBox x:Name="BranchCombo" Header="Филиал (где стоит)"
                                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ СЕКЦИЯ 2: ПОКУПКА ═══ -->
                <Border Style="{StaticResource CardFlatStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="💰 Покупка (продавец — физлицо, данные для ДКП)" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="Цена покупки, ₽" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PurchasePriceTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="ФИО продавца" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SellerNameTextBox" MaxLength="150"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Телефон продавца" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SellerPhoneTextBox" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Паспорт (серия + номер)" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SellerPassportTextBox" MaxLength="50"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ СЕКЦИЯ 3: РЕМОНТ И ПРОДАЖА ═══ -->
                <Border x:Name="RepairSection" Style="{StaticResource CardFlatStyle}" Padding="16" Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🔧 Ремонт и продажа" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="Запчасти, ₽" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PartsCostTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,12">
                                <TextBlock Text="Работы, ₽" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="LaborCostTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,12">
                                <TextBlock Text="Цена в объявлении, ₽" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ListingPriceTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Цена продажи, ₽" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SalePriceTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"
                                         TextChanged="Money_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0">
                                <TextBlock Text="Маржа (продажа − покупка − ремонт)" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="MarginLabel" Text="0 ₽" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentGreen}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Что сделано / примечания по ремонту" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,4"/>
                        <TextBox x:Name="RepairNotesTextBox" MinHeight="60" Padding="10,8"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="🧾 Покупатель (физлицо, данные для ДКП)" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="ФИО покупателя" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="BuyerNameTextBox" MaxLength="150"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Text="Телефон" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="BuyerPhoneTextBox" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Паспорт" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="BuyerPassportTextBox" MaxLength="50"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ СЕКЦИЯ 4: ДЕФЕКТЫ И ЗАМЕТКИ ═══ -->
                <Border Style="{StaticResource CardFlatStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚠️ Дефекты (осмотр при приёмке)" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,8"/>
                        <TextBox x:Name="DefectsTextBox" MinHeight="70" Padding="10,8"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Общие заметки" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,4"/>
                        <TextBox x:Name="NotesTextBox" MinHeight="50" Padding="10,8"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="💾 Сохранить" Style="{StaticResource SuccessBtn}" Click="Save_Click"/>
            <Button Content="✖ Отмена" Style="{StaticResource DangerBtn}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>