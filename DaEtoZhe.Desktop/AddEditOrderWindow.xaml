<Window x:Class="DaEtoZhe.Desktop.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DaEtoZhe.Desktop"
        xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="700"
        Height="950"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="SingleBorderWindow"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="0,20,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="25,0,10,0">
            <StackPanel Margin="0,0,10,20">
                <TextBlock Text="{Binding WindowTitle}"
                           Style="{StaticResource HeadingLargeStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="🏢 Филиал (определяется сменой)"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsAppointment, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <controls:CustomComboBox x:Name="BranchComboBox"
                                         Margin="{StaticResource FormFieldMargin}"
                                         DisplayMemberPath="Name"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding CurrentOrder.BranchId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectionChanged="BranchComboBox_SelectionChanged"
                                         Header="Выберите филиал"
                                         IsEditable="False"
                                         Visibility="{Binding IsAppointment, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <controls:CustomComboBox x:Name="DepartmentComboBox"
                                         Margin="{StaticResource FormFieldMargin}"
                                         Header="📂 Выберите департамент"
                                         SelectedValue="{Binding CurrentDepartment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectedValuePath="Tag"
                                         SelectionChanged="DepartmentComboBox_SelectionChanged"
                                         IsEditable="False">
                    <ComboBoxItem Content="💦 Мойка (автомойка)" Tag="Wash"/>
                    <ComboBoxItem Content="🔧 Сервис (ремонт/ТО)" Tag="Service"/>
                </controls:CustomComboBox>

                <Grid Margin="{StaticResource FormFieldMargin}"
                      Visibility="{Binding IsAppointment, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <controls:CustomComboBox x:Name="ClientComboBox"
                                             Grid.Column="0"
                                             Header="Выберите постоянника"
                                             DisplayMemberPath="DisplayInfo"
                                             SelectedValuePath="Id"
                                             SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                                             IsEditable="True"
                                             MinWidth="550"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Center">
                        <TextBlock Text="Добавить"
                                   Style="{DynamicResource TextSecondaryStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="{StaticResource FormLabelMargin}"/>
                        <Button Content="➕"
                                Click="AddNewClient_Click"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="{StaticResource ControlPaddingLG}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Марка и модель авто"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding CarModel, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{StaticResource FormFieldMargin}"/>

                <TextBlock Text="Государственный номер"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox Text="{Binding CarNumber, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{StaticResource FormFieldMargin}"/>

                <controls:CustomComboBox x:Name="BodyTypeComboBox"
                                         Margin="{StaticResource FormFieldMargin}"
                                         DisplayMemberPath="Name"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedBodyTypeCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Header="Выберите категорию"/>

                <TextBlock Text="⏰ Время заезда"
                           Style="{StaticResource FilterLabelStyle}"
                           Margin="{StaticResource FormLabelMargin}"/>

                <Grid Margin="{StaticResource FormFieldMargin}"
                      Height="45">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <local:CustomDatePicker x:Name="OrderDatePicker"
                                            Grid.Column="0"
                                            Height="45"/>

                    <TextBox x:Name="OrderTimeTextBox"
                             Grid.Column="1"
                             TextAlignment="Center"
                             Height="45"
                             Text="12:00"
                             FontSize="14"
                             FontWeight="Bold"
                             Margin="10,0,0,0"/>
                </Grid>

                <TextBlock Text="⏱️ Длительность (минуты)"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsAppointment, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBox x:Name="DurationTextBox"
                         Margin="{StaticResource FormFieldMargin}"
                         Height="45"
                         Padding="15,0"
                         Text="60"
                         FontSize="14"
                         Visibility="{Binding IsAppointment, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <controls:CustomComboBox x:Name="ZoneComboBox"
                                         Margin="{StaticResource FormFieldMargin}"
                                         ItemsSource="{Binding AvailableZones}"
                                         DisplayMemberPath="Name"
                                         SelectedValuePath="BoxNumber"
                                         SelectedValue="{Binding CurrentOrder.BoxNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEditable="False">
                    <controls:CustomComboBox.Header>
                        <Binding Path="CurrentOrder.Department"
                                 Converter="{StaticResource DepartmentToZoneLabelConverter}"
                                 FallbackValue="🚘 Выберите зону"/>
                    </controls:CustomComboBox.Header>
                </controls:CustomComboBox>

                <controls:CustomComboBox x:Name="WasherComboBox"
                                         Margin="{StaticResource FormFieldMargin}"
                                         ItemsSource="{Binding Washers}"
                                         DisplayMemberPath="UserDisplayInfo"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding SelectedWasherId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Header="👤 Выберите сотрудника"
                                         Visibility="{Binding IsAppointment, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                         IsEditable="True"/>

                <TextBlock Text="🔍 Поиск услуги"
                           Style="{StaticResource FilterLabelStyle}"
                           Margin="{StaticResource FormLabelMargin}"/>

                <TextBox x:Name="ServiceSearchTextBox"
                         Margin="{StaticResource FormFieldMargin}"
                         TextChanged="ServiceSearchTextBox_TextChanged"
                         Tag="Введите название услуги..."/>

                <TextBlock Text="🛠️ Выберите услуги"
                           Style="{StaticResource FilterLabelStyle}"
                           Margin="{StaticResource FormLabelMargin}"/>

                <ListBox x:Name="ServicesListBox"
                         MinHeight="120"
                         MaxHeight="180"
                         Margin="{StaticResource FormFieldMargin}"
                         ItemsSource="{Binding Services}"
                         SelectionMode="Multiple"
                         SelectionChanged="ServicesListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="MinHeight" Value="45"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Border"
                                                Background="{DynamicResource BgCard}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="0,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="💰 Дополнительная стоимость"
                           Style="{StaticResource FilterLabelStyle}"
                           Margin="{StaticResource FormLabelMargin}"/>

                <TextBox Text="{Binding ExtraCost,
                             UpdateSourceTrigger=PropertyChanged,
                             TargetNullValue=0,
                             FallbackValue=0,
                             ValidatesOnExceptions=False,
                             Converter={StaticResource DecimalToEmptyZeroConverter}}"
                         Margin="{StaticResource FormFieldMargin}"/>

                <TextBlock Text="📝 Причина дополнительной стоимости"
                           Style="{StaticResource FilterLabelStyle}"
                           Margin="{StaticResource FormLabelMargin}"/>

                <TextBox Text="{Binding CurrentOrder.ExtraCostReason, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{StaticResource FormFieldMargin}"/>

                <controls:CustomComboBox x:Name="StatusComboBox"
                                         Margin="{StaticResource FormFieldMargin}"
                                         DisplayMemberPath="DisplayName"
                                         SelectedValuePath="Name"
                                         SelectedValue="{Binding CurrentOrder.Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Header="📋 Статус заказа"
                                         IsEditable="False"
                                         Visibility="{Binding IsAppointment, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                <TextBlock Text="🎁 Скидка"
                           Style="{StaticResource FilterLabelStyle}"
                           Margin="{StaticResource FormLabelMargin}"/>

                <StackPanel Margin="{StaticResource FormFieldMargin}">
                    <controls:CustomComboBox Header="Применить правило (например, Дождь...)"
                                             ItemsSource="{Binding DiscountRules}"
                                             SelectedItem="{Binding SelectedDiscountRule, Mode=TwoWay}"
                                             DisplayMemberPath="Name"
                                             SelectedValuePath="Id"
                                             IsEditable="False"
                                             Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="DiscountPercentTextBox"
                                 Grid.Column="0"
                                 Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalToEmptyZeroConverter}}"/>

                        <TextBlock Grid.Column="1"
                                   Text=" % "
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CardHeaderStyle}"
                                   Margin="{StaticResource FormLabelMargin}"/>

                        <TextBox x:Name="DiscountAmountTextBox"
                                 Grid.Column="2"
                                 Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalToEmptyZeroConverter}}"/>
                    </Grid>

                    <TextBlock Text="Или введите значения вручную"
                               Style="{StaticResource TextCaptionStyle}"
                               Margin="{StaticResource FormLabelMargin}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <controls:CustomComboBox x:Name="PaymentMethodComboBox"
                                         Margin="{StaticResource FormFieldMargin}"
                                         DisplayMemberPath="Name"
                                         SelectedValuePath="Name"
                                         SelectedValue="{Binding CurrentOrder.PaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Header="💳 Способ оплаты"
                                         IsEditable="False"
                                         Visibility="{Binding IsAppointment, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                <Border Background="{DynamicResource UpsellBannerBg}"
                        BorderBrush="{DynamicResource UpsellBannerBorder}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,10,0,20"
                        Visibility="{Binding CurrentSuggestion, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="💡 СОВЕТ:"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource UpsellBannerText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentSuggestion.Message}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CurrentSuggestion.BonusAmount, StringFormat='Ваш бонус: {0:N0} ₽'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource UpsellBonusText}"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Добавить"
                                Click="ApplyUpsell_Click"
                                Style="{StaticResource SuccessBtn}"
                                Padding="20,8"
                                Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <TabControl Margin="0,10,0,20"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="{Binding IsAppointment, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TabItem Header="📋 Лента">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="5">
                            <Border Background="{DynamicResource TabContentBg}"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="5"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1">
                                <ListBox ItemsSource="{Binding OrderTimeline}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                    BorderBrush="{DynamicResource TimelineCardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <WrapPanel Grid.Column="0"
                                                               Margin="0,0,12,0"
                                                               HorizontalAlignment="Stretch"
                                                               MinWidth="50">
                                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd.MM}}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMain}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text=" | "
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource TextMuted}"/>
                                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextMain}"
                                                                   HorizontalAlignment="Center"/>
                                                    </WrapPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding EntryTypeIcon}"
                                                                       FontSize="14"
                                                                       Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding CreatedBy}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextMain}"/>
                                                            <TextBlock Text="•"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       Margin="6,0"/>
                                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMuted}"/>
                                                        </WrapPanel>

                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Message}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextMain}"/>
                                                            <TextBlock Text=" | "
                                                                       Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Text="{Binding RelatedEntityInfo}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextLightMuted}"
                                                                       FontStyle="Italic"
                                                                       Visibility="{Binding RelatedEntityInfo, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="💰 Расходы">
                        <Border Background="{DynamicResource TabContentBg}"
                                CornerRadius="6"
                                Padding="15"
                                Margin="5"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                    <TextBlock Text="➕ Добавить расход"
                                               Style="{StaticResource FilterLabelStyle}"
                                               Margin="{StaticResource FormLabelMargin}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="ExpenseNameTextBox"
                                                 ToolTip="Название (масло, запчасть...)"/>

                                        <Button Grid.Column="1"
                                                Content="Добавить"
                                                Click="AddExpenseButton_Click"
                                                Style="{StaticResource SuccessBtn}"
                                                Margin="{StaticResource ButtonGapMargin}"/>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="ExpenseCostPriceTextBox"
                                                 Grid.Column="0"
                                                 ToolTip="Себестоимость ₽"/>

                                        <TextBox x:Name="ExpenseClientPriceTextBox"
                                                 Grid.Column="1"
                                                 ToolTip="Цена для клиента ₽"/>

                                        <TextBox x:Name="ExpenseQuantityTextBox"
                                                 Grid.Column="2"
                                                 ToolTip="Кол-во"
                                                 Text="1"/>
                                    </Grid>

                                    <controls:CustomComboBox x:Name="ExpenseCategoryComboBox"
                                                             Header="Выберите категорию"
                                                             SelectedValuePath="Tag"
                                                             IsEditable="False"
                                                             Margin="{StaticResource FormFieldMargin}">
                                        <ComboBoxItem Content="🔧 Запчасти" Tag="Parts"/>
                                        <ComboBoxItem Content="🧴 Расходники" Tag="Consumables"/>
                                        <ComboBoxItem Content="🤝 Сторонние работы" Tag="ExternalWork"/>
                                    </controls:CustomComboBox>

                                    <TextBox x:Name="ExpenseNoteTextBox"
                                             ToolTip="Комментарий..."
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Margin="{StaticResource FormLabelMargin}"/>
                                </StackPanel>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding OrderExpenses}"
                                         Margin="0,0,0,15"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ExpenseCardBg}"
                                                    CornerRadius="6"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextMain}"/>
                                                        <TextBlock Text="{Binding Category, StringFormat='📂 {0}'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMuted}"/>
                                                        <TextBlock Text="{Binding Note}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextLightMuted}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding Note, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ClientPrice, StringFormat={}{0:N0} ₽}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentGreen}"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat='×{0}'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="2"
                                        Background="{DynamicResource ExpenseTotalBg}"
                                        CornerRadius="6"
                                        Padding="12">
                                    <TextBlock Text="{Binding TotalExpensesAmount, StringFormat='💰 Итого расходов: {0:N0} ₽'}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentGreen}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>

                <Border Background="{DynamicResource SummaryPanelBg}"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,10,0,0"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding ServicesTotal, StringFormat=💰 Услуги: {0:N0} ₽}"/>

                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource AccentOrange}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding ExtraCost, StringFormat=➕ Дополнительно: {0:N0} ₽}"/>

                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource AccentRed}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding DiscountAmount, StringFormat=🎁 Скидка: {0:N0} ₽}"
                                   Visibility="{Binding DiscountAmount, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                        <TextBlock FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentGreen}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding FinalTotal, StringFormat=💰 Итого: {0:N0} ₽}"/>

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding WasherEarningsDisplay, StringFormat='👤 Мойщику: {0:N0} ₽'}"/>

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding CompanyEarningsDisplay, StringFormat='🏢 Компании: {0:N0} ₽'}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="{StaticResource FormSectionTopMargin}">
            <Button x:Name="ConvertToOrderButton"
                    Content="📅 Преобразовать в заказ"
                    Click="ConvertToOrderButton_Click"
                    Style="{StaticResource PurpleBtn}"
                    Visibility="{Binding IsAppointment, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Button Content="🖨 Акт выполненных работ"
                    Click="PrintActButton_Click"
                    Style="{StaticResource PrimaryBtn}"/>

            <Button Content="✅ Сохранить"
                    Click="SaveButton_Click"
                    Style="{StaticResource SuccessBtn}"/>

            <Button Content="✖ Отмена"
                    Click="CloseButton_Click"
                    Style="{StaticResource DangerBtn}"/>
        </StackPanel>

        <Button Content="✖"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Click="CloseButton_Click"
                Style="{StaticResource IconButtonStyle}"
                Background="{StaticResource ButtonDanger}"/>
    </Grid>
</Window>