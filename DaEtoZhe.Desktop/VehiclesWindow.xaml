<Window x:Class="DaEtoZhe.Desktop.VehiclesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
        xmlns:local="clr-namespace:DaEtoZhe.Desktop"
        Title="🚗 Авто под ремонт и продажу"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="1200" MinHeight="700"
        Width="1400" Height="850"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🚗 Авто под ремонт и продажу" 
                       Style="{StaticResource HeadingLargeStyle}"/>
            <TextBlock Text="Управление автомобилями для ремонта и перепродажи" 
                       Style="{StaticResource TextSecondaryStyle}" 
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. Фильтры и действия -->
        <Border Grid.Row="1"
                Style="{StaticResource CardFlatStyle}"
                Margin="{StaticResource CardGapMargin}">
            <!-- Один компактный ряд из трёх колонок. Внутренние StackPanel не растягивают
                 промежуток между подписью и полем при наличии свободной высоты. -->
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок входит в CustomComboBox и участвует в измерении его высоты. -->
                <controls:CustomComboBox x:Name="StatusFilter"
                                         Grid.Column="0"
                                         Header="Статус"
                                         Placeholder="Все статусы"
                                         VerticalAlignment="Top"
                                         SelectionChanged="StatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Все статусы" Tag=""/>
                    <ComboBoxItem Content="Новый" Tag="0"/>
                    <ComboBoxItem Content="Куплен" Tag="1"/>
                    <ComboBoxItem Content="Оценен" Tag="2"/>
                    <ComboBoxItem Content="В ремонте" Tag="3"/>
                    <ComboBoxItem Content="Предпродажная подготовка" Tag="4"/>
                    <ComboBoxItem Content="Выставлен на продажу" Tag="5"/>
                    <ComboBoxItem Content="Зарезервирован" Tag="6"/>
                    <ComboBoxItem Content="Продан" Tag="7"/>
                    <ComboBoxItem Content="Списан" Tag="8"/>
                </controls:CustomComboBox>

                <!-- Поиск использует ту же схему: label + поле с фиксированным зазором. -->
                <StackPanel Grid.Column="1"
                            Margin="{StaticResource ControlPaddingLG}"
                            VerticalAlignment="Top">
                    <TextBlock Text="Поиск"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="{StaticResource FormLabelMargin}"/>
                    <TextBox x:Name="SearchBox"
                             Height="{StaticResource ControlHeightMD}"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <!-- Панель действий привязана к нижнему краю строки полей. -->
                <StackPanel Grid.Column="2"
                            Orientation="Vertical"
                            VerticalAlignment="Bottom">

                            <TextBlock Text="Действия"
                                       Style="{StaticResource FormLabelStyle}"
                                       Margin="{StaticResource FormLabelMargin}"/>

                    <StackPanel Orientation="Horizontal">

                    <Button Content="➕ Добавить авто"
                            Click="AddVehicle_Click"
                            Style="{StaticResource PrimaryBtn}"/>
                    <Button Content="🔄 Обновить"
                            Click="RefreshButton_Click"
                            Style="{StaticResource SecondaryBtn}"/>
                    <Button Content="✖ Закрыть"
                            Click="CloseButton_Click"
                            Style="{StaticResource DangerBtn}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>


        <!-- 3. Карточки авто -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="VehiclesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardInteractiveStyle}"
                                Width="340" 
                                Margin="0,0,12,12">
                            <StackPanel>
                                <!-- Шапка карточки -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Make}" Style="{StaticResource HeadingSmallStyle}"/>
                                        <TextBlock Text="{Binding Model}" Style="{StaticResource TextSecondaryStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" 
                                            Background="{Binding Status, Converter={StaticResource VehicleStatusToColorConverter}}"
                                            CornerRadius="{DynamicResource RadiusXS}" 
                                            Padding="8,4" 
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource VehicleStatusToTextConverter}}"
                                                   Foreground="White" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="{DynamicResource FontSizeSM}"/>
                                    </Border>
                                </Grid>

                                <!-- Детали -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Гос. номер:" Style="{StaticResource TextSecondaryStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicensePlate}" Style="{StaticResource TextPrimaryStyle}" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Год / Пробег:" Style="{StaticResource TextSecondaryStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TextPrimaryStyle}" Margin="0,4,0,0">
                                        <Run Text="{Binding Year}"/>
                                        <Run Text=" г., "/>
                                        <Run Text="{Binding Mileage, StringFormat=N0}"/>
                                        <Run Text=" км"/>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Цена продажи:" Style="{StaticResource TextSecondaryStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ListingPrice, StringFormat={}{0:N0} ₽}" 
                                               Foreground="{DynamicResource AccentGreen}" 
                                               FontWeight="Bold" 
                                               Margin="0,4,0,0"/>
                                </Grid>

                                <!-- VIN и Дата -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Vin, StringFormat=VIN: {0}}" Style="{StaticResource TextCaptionStyle}"/>
                                    <TextBlock Text="{Binding PurchaseDate, StringFormat=от dd.MM.yyyy}" Style="{StaticResource TextCaptionStyle}" DockPanel.Dock="Right"/>
                                </DockPanel>

                                <!-- Кнопки действий (используем IconButtonStyle без сжатия по высоте!) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️" ToolTip="Редактировать" Click="EditVehicle_Click" Style="{StaticResource IconButtonStyle}"/>
                                    <Button Content="📋" ToolTip="Приёмка" Click="Acceptance_Click" Style="{StaticResource IconButtonStyle}"/>
                                    <Button Content="🔧" ToolTip="Ремонт" Click="Repair_Click" Style="{StaticResource IconButtonStyle}"/>
                                    <Button Content="🔄" ToolTip="Статус" Click="ChangeStatus_Click" Style="{StaticResource IconButtonStyle}"/>
                                    <Button Content="🗑️" ToolTip="Удалить" Click="DeleteVehicle_Click" Style="{StaticResource DangerBtn}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4. Статистика снизу -->
        <Border Grid.Row="3" 
                Style="{StaticResource StatCard}" 
                Margin="0,16,0,0">
            <UniformGrid Columns="5">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Всего авто" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalCountText" Style="{StaticResource HeadingMediumStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="В ремонте" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InRepairCountText" Style="{StaticResource HeadingMediumStyle}" Foreground="{DynamicResource AccentOrange}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="На продаже" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ForSaleCountText" Style="{StaticResource HeadingMediumStyle}" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Продано" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SoldCountText" Style="{StaticResource HeadingMediumStyle}" Foreground="{DynamicResource AccentGreen}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Общая маржа" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalMarginText" Style="{StaticResource HeadingMediumStyle}" Foreground="{DynamicResource AccentGreen}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Window>